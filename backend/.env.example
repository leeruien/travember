# Copy to backend/.env and fill in from the Supabase dashboard.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Connect -> Session pooler (IPv4-friendly). Convert the URI to JDBC form:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=your-database-password

# Optional: only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys).
SUPABASE_JWT_SECRET=

# Comma-separated origin patterns allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
