# Copy to agent/.env and fill in.

# Free from Google AI Studio: https://aistudio.google.com/apikey
# On the free tier, Google may use prompts and answers to improve its products, and requests per
# minute and per day are limited; each plan makes roughly 8-15 requests.
GEMINI_API_KEY=

# Same Supabase project URL as the backend: used to check that whoever asks for a plan is signed in.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Optional: only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys).
SUPABASE_JWT_SECRET=

# Where the Travember API and web app run, for the tool that reads other travellers' pages.
TRAVEMBER_API_URL=http://localhost:8080
TRAVEMBER_WEB_URL=http://localhost:5173

# Optional tuning. gemini-flash-lite-latest is the free tier's most available model; gemini-flash-latest
# (or a named one such as gemini-3.5-flash) plans a little better when it isn't busy.
AGENT_MODEL=gemini-flash-lite-latest
AGENT_PLANS_PER_HOUR=10
