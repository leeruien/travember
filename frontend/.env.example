# Copy to frontend/.env and fill in from the Supabase dashboard (same project as the backend).

# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys -> Publishable key (sb_publishable_...). A legacy anon key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the Spring Boot API is running.
VITE_API_URL=http://localhost:8080

# Where the itinerary planner agent (agent/) is running.
VITE_AGENT_URL=http://localhost:8000
